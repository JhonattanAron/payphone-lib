{
  "name": "@jhonattanaron/payphone-lib",
  "version": "1.0.0",
  "description": "PayPhone Button API server client and frontend checkout utilities",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {"types": "./dist/index.d.ts", "import": "./dist/index.js"},
    "./backend": {"types": "./dist/backend/client.d.ts", "import": "./dist/backend/client.js"},
    "./frontend": {"types": "./dist/frontend/checkout.d.ts", "import": "./dist/frontend/checkout.js"}
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {"build": "tsc -p tsconfig.json", "prepare": "npm run build"},
  "devDependencies": {"@types/node": "^22.0.0", "typescript": "^5.7.0"},
  "engines": {"node": ">=20"}
}
