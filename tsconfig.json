{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "declaration": true, "outDir": "dist", "rootDir": "src",
    "skipLibCheck": true, "esModuleInterop": true, "jsx": "react-jsx", "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"], "exclude": ["node_modules", "dist", "examples"]
}
